# ============ Sumber data ============
SOURCE_BASE=https://gsm-app.com/lovelive/ikizulive-x-archive
CHECK_INTERVAL_MINUTES=10

# ============ Discord (fitur utama) ============
# Buat webhook: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=
NOTIFY_WITHOUT_TRANSLATION=false

# ============ Ekspor dataset publik (JSON) ============
# Folder keluaran dataset (JSONL per bulan + members.json + stats.json + index.json).
# Dipakai viewer GitHub Pages & orang lain yang mau pakai datanya tanpa API key.
EXPORT_DIR=./dataset
EXPORT_ON_CYCLE=true

# ============ Translasi (gateway OpenAI-compatible / OmniRoute) ============
# Isi dengan endpoint gateway-mu sendiri. Default OmniRoute: http://localhost:20128/v1
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
TRANSLATE_MODEL=atria/Atria-Dawn-Preview
TRANSLATE_MODEL_FALLBACK=
TRANSLATE_REASONING_EFFORT=none
TRANSLATE_MAX_TOKENS=2500
TRANSLATE_BATCH_SIZE=5
TRANSLATE_BATCH_PER_CYCLE=20
TRANSLATE_MAX_ATTEMPTS=8
TRANSLATE_RETRY_BACKOFF_MIN=60
TRANSLATE_RETRY_BACKOFF_MAX=900
TRANSLATE_PAUSED=false

# ============ Web / runtime ============
PORT=8097
RUN_ONCE=false
DRY_RUN=false
BACKFILL_ON_START=true
LOG_LEVEL=INFO
